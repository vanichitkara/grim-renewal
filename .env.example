# Copy to .env (git-ignored). `npm run bridge` fills in the key by itself on first run.
# This key protects the browser bridge on YOUR machine only. It is a local secret.
# Do NOT add it to Vercel, GitHub Pages or any hosted setting, and do NOT prefix it with VITE_:
# a built website is public, so anything inside it is public too.
GRIM_BRIDGE_TOKEN=

# Address of the shared-tips server (public, not a secret). Empty turns the feature off.
# Local test: http://127.0.0.1:8788 (run `npm run community`). Live: an https address.
GRIM_COMMUNITY_URL=

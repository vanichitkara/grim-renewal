{
  "name": "grim-renewal",
  "version": "0.1.0",
  "description": "Make sure the dead stay dead. Find forgotten subscriptions, cancel them while you watch.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "bridge": "tsx server/browser-bridge.ts",
    "bridge:check": "tsx server/bridge-check.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "community": "tsx server/community-api.ts",
    "extension:zip": "tsx scripts/pack-extension.mts",
    "extension:check": "tsx scripts/check-extension.mts"
  },
  "dependencies": {
    "fast-check": "3.22.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.85",
    "@types/node": "20.14.0",
    "eslint": "8.57.0",
    "tsx": "4.23.15",
    "typescript": "5.4.5",
    "vite": "5.3.1",
    "vitest": "1.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

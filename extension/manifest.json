{
  "manifest_version": 3,
  "name": "Grim Renewal Reaper",
  "version": "0.1.0",
  "description": "Lets the Grim Renewal site cancel a subscription in your own Chrome, one approved click at a time. Never types, never reads passwords.",
  "key": "",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Grim Renewal Reaper", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }, "default_popup": "popup.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "externally_connectable": {
    "matches": [
      "https://vanichitkara.github.io/*",
      "http://localhost:5173/*",
      "http://localhost:4173/*",
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:4173/*"
    ]
  }
}
